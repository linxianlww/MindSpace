<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 仅在"音频铭记-录音"时动态申请；不申请存储根目录权限，媒体走系统 Photo Picker。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- TOTP 扫码导入（mobile_scanner）；仅在前台使用相机时动态申请。 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- 私密空间：指纹 / 面容解锁 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-feature android:name="android.hardware.fingerprint" android:required="false"/>
    <!-- 纯本地优先应用，不需要联网权限。 -->
    <!-- 媒体轮播小组件使用 setInexactRepeating（非精确闹钟），无需 SCHEDULE_EXACT_ALARM 权限。 -->

    <application
        android:label="NekoBox"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true">
        <!-- largeHeap：Android 8.x 低配机位图/GL 内存预算紧张，大图查看、
             PDF 渲染、图片旋转/裁剪等重任务需要更多堆空间，否则直接 OOM 崩溃。 -->
        <!--
            MainActivity：主启动入口 + 所有分享接收 / otpauth / 文本选择的汇聚点。
            单一 Activity 接收所有 intent，按 action/mimeType 在 Flutter 侧分流处理：
            PROCESS_TEXT → 文本铭记；SEND(SINGLE) → 按类型创建对应铭记；
            SEND_MULTIPLE → 媒体集（图片/视频）；VIEW(otpauth)→ TOTP 铭记。
            所有铭记默认保存到根目录（folderId = null）。
        -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- 桌面快捷方式（App Shortcuts）：长按桌面图标弹出菜单 -->
            <meta-data
              android:name="android.app.shortcuts"
              android:resource="@xml/shortcuts" />
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- 文本选择菜单：长按选中文本后出现在系统「复制/粘贴」浮动栏 -->
            <!-- android:label 即为菜单项文本 -->
            <intent-filter android:label="@string/save_as_memo">
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>

            <!-- 分享接收：文本 / txt / markdown / rtf → 文本铭记 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/x-markdown"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/rtf"/>
            </intent-filter>

            <!-- 分享接收：图片 / 视频（复数）→ 媒体集 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>

            <!-- 分享接收：音频（单文件）→ 音频铭记 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>

            <!-- 分享接收：通用文件（office、pdf、未知）→ 文件铭记 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/*"/>
            </intent-filter>

            <!-- 打开链接：otpauth:// TOTP → TOTP 铭记 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="otpauth"/>
            </intent-filter>

            <!-- 桌面快捷方式 deep link：nekobox://memo/{type}/{id} → 打开对应铭记 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="nekobox" android:host="memo"/>
            </intent-filter>

            <!-- 桌面快捷方式 deep link：nekobox://app/text|new/todo|new → 打开 app 并执行新建操作 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="nekobox" android:host="app"/>
            </intent-filter>
        </activity>

        <!-- 私密空间分享接收方：在系统分享表中以「保存到私密空间」身份出现；
             收到 ACTION_SEND 后转发给 MainActivity，并注入 targetFolderId = __private_space__
             （主 Activity 解析分享时通过 ShareReceiverHelper.targetFolderId(event) 写入 map，
              Dart 侧 getInitialShare 读取后按字段分流）。-->
        <activity
            android:name=".ShareReceiverActivity"
            android:label="@string/save_to_private_space"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/x-markdown"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/rtf"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="otpauth"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- image_cropper (uCrop) 必需：缺失时点击裁剪会 ActivityNotFound 崩溃。 -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Ucrop.CropTheme"/>
    </application>

    <!-- Android 11+ 包可见性：open_filex / url_launcher / share 需要查询可处理的目标应用。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="*/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="*/*"/>
        </intent>
        <!-- url_launcher 外部浏览器 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
